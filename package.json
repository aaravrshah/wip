{
  "name": "wip",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev --filter=@wip/web",
    "dev:web": "turbo dev --filter=@wip/web",
    "dev:extension": "turbo dev --filter=@wip/extension",
    "build": "turbo build",
    "build:extension": "turbo build --filter=@wip/extension",
    "zip:extension": "pnpm --filter @wip/extension zip",
    "db:generate": "pnpm --filter @wip/database db:generate",
    "db:migrate": "pnpm --filter @wip/database db:migrate",
    "db:seed": "pnpm --filter @wip/database db:seed",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:integration": "turbo test:integration"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "turbo": "^2.10.8"
  }
}
