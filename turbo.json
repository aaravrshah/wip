{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "WIP_DATA_SOURCE",
    "WIP_ALLOW_PRODUCTION_DEMO",
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
    "CLERK_SECRET_KEY",
    "CLERK_JWT_TEMPLATE",
    "NEON_AUTHENTICATED_DATABASE_URL"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "@wip/domain#build": {
      "outputs": []
    },
    "@wip/database#build": {
      "outputs": []
    },
    "@wip/fixtures#build": {
      "outputs": []
    },
    "format:check": {
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    }
  }
}
