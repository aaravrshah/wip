{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "WIP_DATA_SOURCE",
    "WIP_ALLOW_PRODUCTION_DEMO",
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
    "CLERK_SECRET_KEY",
    "NEON_RUNTIME_DATABASE_URL",
    "WIP_WEB_ORIGIN",
    "WIP_EXTENSION_ORIGINS",
    "WXT_WIP_API_ORIGIN",
    "WXT_CLERK_PUBLISHABLE_KEY",
    "WXT_CLERK_FRONTEND_API_ORIGIN",
    "WXT_WIP_EXTENSION_ID",
    "WXT_WIP_EXTENSION_PUBLIC_KEY"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "@wip/domain#build": {
      "outputs": []
    },
    "@wip/database#build": {
      "outputs": []
    },
    "@wip/fixtures#build": {
      "outputs": []
    },
    "@wip/schemas#build": {
      "outputs": []
    },
    "@wip/extension#build": {
      "outputs": [".output/**"]
    },
    "format:check": {
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    }
  }
}
