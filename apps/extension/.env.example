# WXT exposes only WXT_-prefixed variables to extension code. All values here are public.
WXT_WIP_API_ORIGIN=http://localhost:3000
WXT_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_CLERK_PUBLISHABLE_KEY
WXT_CLERK_FRONTEND_API_ORIGIN=https://YOUR_CLERK_FRONTEND_API
# Defaults are the checked-in public development identity. Override both only for a Chrome Web
# Store item or another intentionally registered build; never add a private signing key.
# WXT_WIP_EXTENSION_ID=REPLACE_WITH_REGISTERED_EXTENSION_ID
# WXT_WIP_EXTENSION_PUBLIC_KEY=REPLACE_WITH_MATCHING_PUBLIC_KEY_ONLY
