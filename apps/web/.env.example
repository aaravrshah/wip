# Select "demo" for the explicit fictional in-memory source or "neon" for Clerk + Neon RLS.
WIP_DATA_SOURCE=demo

# Exact trusted web and unpacked-extension origins. Set the Chrome origin after loading the build.
WIP_WEB_ORIGIN=http://localhost:3000
WIP_EXTENSION_ORIGINS=chrome-extension://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# Clerk application keys. The secret key is server-only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_test_REPLACE_WITH_CLERK_SECRET_KEY
CLERK_JWT_TEMPLATE=neon
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Passwordless pooled Neon RLS URL used only by authenticated server reads and scoped writes.
NEON_AUTHENTICATED_DATABASE_URL=postgresql://authenticated@POOLER_HOST/DATABASE?sslmode=require

# Privileged pooled Neon URL used only by fictional seed tooling, never web requests.
DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST/DATABASE?sslmode=require

# Privileged direct Neon URL used only by drizzle-kit migrations.
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require

# Fictional seed owner. Authenticated runtime code does not read this value.
WIP_OWNER_ID=00000000-0000-5000-8000-000000000001

# Optional disposable integration branch settings. Never point these at production.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@TEST_DIRECT_HOST/TEST_DATABASE?sslmode=require
TEST_NEON_AUTHENTICATED_DATABASE_URL=postgresql://authenticated@TEST_POOLER_HOST/TEST_DATABASE?sslmode=require
TEST_CLERK_USER_A_JWT=REPLACE_WITH_SHORT_LIVED_TEST_USER_A_JWT
TEST_CLERK_USER_B_JWT=REPLACE_WITH_SHORT_LIVED_TEST_USER_B_JWT
# TEST_CLERK_EXPIRED_JWT=REPLACE_WITH_AN_EXPIRED_TEST_JWT

# Explicit escape hatch for a production-mode demo build; never set on a real deployment.
WIP_ALLOW_PRODUCTION_DEMO=false
